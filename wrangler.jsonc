{
  "name": "churrri-quizrun-online",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-07-30",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/quizrun/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": { "ALLOWED_ORIGINS": "" },
  "ratelimits": [
    { "name": "ROOM_CREATES", "namespace_id": "411891", "simple": { "limit": 8, "period": 60 } },
    { "name": "ROOM_REQUESTS", "namespace_id": "411892", "simple": { "limit": 240, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
